CORTI_ENVIRONMENT=eu
CORTI_TENANT=base
CORTI_CLIENT_ID=
CORTI_CLIENT_SECRET=

# Syv.ai (Plapre) dansk TTS - noegle fra platform.syv.ai
SYV_API_KEY=
SYV_TTS_MODEL=syvai/plapre-nano

# Corti-agent med vores MCP-vidensbase som connector
CORTI_CHAT_AGENT_ID=
# Egen MCP-server (cosurg-mcp). Tokenet staar i STIEN, ikke i en header.
# Er begge sat, kobler /chat serveren paa sin egen agent som ekstra ekspert
# ved siden af PubMed - der skal ikke aendres kode.
MCP_URL=https://mcp.cosurg.com/mcp
MCP_AUTH_TOKEN=

# Kun hvis MCP-serveren skal naas paa en helt anden fuld URL end MCP_URL/token.
COSURG_MCP_URL=
