CORTI_ENVIRONMENT=eu
CORTI_TENANT=base
CORTI_CLIENT_ID=
CORTI_CLIENT_SECRET=

# Corti Models - Cortis egne LLM'er paa et OpenAI-kompatibelt endpoint.
# Bruges til det HURTIGE: triage, intent-routing og sammenskrivning af uddrag
# vi selv har hentet. Maalt 0,7-2,0 s mod 35-72 s gennem det agentiske framework.
# Uden noeglen koerer appen videre - bare paa den lokale reserve og det tunge spor.
CORTI_MODELS_KEY=
CORTI_MODELS_URL=https://ai.eu.corti.app/v1
# Modelvalg. Skift kun hvis Corti omdoeber eller udvider modellerne.
CORTI_MODELS_TRIAGE=corti-s1-instant
CORTI_MODELS_SYNTHESIS=corti-s1-mini

# Syv.ai (Plapre) dansk TTS - noegle fra platform.syv.ai
SYV_API_KEY=
SYV_TTS_MODEL=syvai/plapre-nano

# Corti-agent med vores MCP-vidensbase som connector
CORTI_CHAT_AGENT_ID=
# Egen MCP-server (cosurg-mcp). Tokenet staar i STIEN, ikke i en header.
# Er begge sat, kobler /chat serveren paa sin egen agent som ekstra ekspert
# ved siden af PubMed - der skal ikke aendres kode.
MCP_URL=https://mcp.cosurg.com/mcp
MCP_AUTH_TOKEN=

# Kun hvis MCP-serveren skal naas paa en helt anden fuld URL end MCP_URL/token.
COSURG_MCP_URL=
