# cosurg-mcp — miljoevariabler. Kopiér til .env og udfyld.

# PAAKRAEVET. Bearer-token(s) Corti skal praesentere. Kommasepareret for flere.
# Mindst 24 tegn pr. token. Generér fx med:  openssl rand -hex 32
MCP_AUTH_TOKEN=

# Netvaerk
HOST=0.0.0.0
PORT=8787
MCP_PATH=/mcp

# Hvor kildefilerne ligger. Standard virker baade i repoet og i Docker-imaget.
# COSURG_KILDE_DIR=/app/data/kilder
# COSURG_TRAE_DIR=/app/data/trees

# PubMed E-utilities. Noeglen er valgfri — uden den er graensen 3 kald/sekund,
# med den 10 kald/sekund. NCBI beder om vaerktoejsnavn og kontaktmail.
# PUBMED_API_KEY=
PUBMED_TOOL=cosurg-mcp
PUBMED_EMAIL=mads@mahope.dk
PUBMED_TIMEOUT_MS=12000

# Kun til lokal fejlsoegning: koer helt uden autentifikation.
# MCP_ALLOW_ANONYMOUS=1
