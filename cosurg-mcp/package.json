{
  "name": "cosurg-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "MCP-server med CoSurgs kliniske vidensbase — brandsaar.dk, teamets eget materiale, beslutningstraeerne og PubMed-opslag. Kobles paa Cortis agentic framework som MCP-connector.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "cosurg-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
